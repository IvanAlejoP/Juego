<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ar.edu.unlu.poo.juego.gui.FinController">
    <children>
        <VBox alignment="CENTER" spacing="30.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label fx:id="resultado" text="Fin del juego" textAlignment="CENTER">
                    <font>
                        <Font size="40.0" />
                    </font>
                </Label>
                <Button mnemonicParsing="false" onAction="#volverAlMenu" prefWidth="220.0" text="Volver al Menú" />
            </children>
        </VBox>
    </children>
</AnchorPane>
