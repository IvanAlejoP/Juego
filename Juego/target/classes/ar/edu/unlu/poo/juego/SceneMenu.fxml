<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ar.edu.unlu.poo.juego.gui.MenuController">
   <children>
      <VBox alignment="CENTER" spacing="30.0"
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Text text="ZOMBIE" textAlignment="CENTER">
               <font>
                  <Font size="60.0" />
               </font>
            </Text>
            <Button mnemonicParsing="false" onAction="#btnJugar" prefWidth="220.0" text="JUGAR" />
            <Button mnemonicParsing="false" prefWidth="220.0" text="Instrucciones" />
            <Button mnemonicParsing="false" onAction="#btnSalir" prefWidth="220.0" text="SALIR" />
         </children>
      </VBox>
   </children>
</AnchorPane>
